{
  "name": "py5 Audio Visualiser",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--device=/dev/dri",
    "--group-add=video",
    "--group-add=render"
  ],
"mounts": [
    // X11 Graphics Passthrough
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.Xauthority,target=/home/vscode/.Xauthority,type=bind,consistency=cached",
    
    // Sensible Audio Passthrough (Dynamic local runtime dir mapping)
    "source=${localEnv:XDG_RUNTIME_DIR}/pulse,target=/run/user/1000/pulse,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/home/vscode/.Xauthority",
    
    // Direct Pulse to our standard mapped path inside the container
    "PULSE_SERVER": "unix:/run/user/1000/pulse/native",
    
    // Hardware Acceleration / Render params
    "LIBGL_ALWAYS_SOFTWARE": "0", 
    "JAVA_TOOL_OPTIONS": "-Djavax.accessibility.assistive_technologies= -Djava.awt.headless=false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvInTerminal": false,
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "sudo uv pip install --system -e . && python -c \"import py5_tools; print(py5_tools.get_jvm_debug_info())\""
}